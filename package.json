{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:vercel": "NITRO_PRESET=vercel vite build",
    "verify:vercel": "node scripts/verify-vercel-build.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app lib proxy.ts next.config.ts vite.config.ts playwright.config.ts scripts tests components/ui/tabs.tsx",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check app lib proxy.ts next.config.ts vite.config.ts playwright.config.ts scripts tests .github package.json",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm build:vercel && pnpm verify:vercel && pnpm test:e2e",
    "test:live": "node scripts/check-production.mjs",
    "security:audit": "pnpm audit --audit-level=moderate"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "0.3.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.1",
    "react-server-dom-webpack": "19.3.0",
    "recharts": "3.10.1",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.62.0",
    "@cloudflare/workers-types": "5.20260928.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.143.0",
    "yaml": "2.9.1"
  },
  "type": "module"
}
